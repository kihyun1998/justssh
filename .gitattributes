# Auto detect text files and perform LF normalization
* text=auto

# Key files made by ssh-keygen, openssl, WinSCP and PuTTYgen for tests, kept byte for byte.
crates/justssh-keys/tests/keys/* -text
crates/justssh-keys/tests/ppk/* -text
crates/justssh-keys/tests/pem/* -text
# Fuzz inputs are bytes, kept as they are.
fuzz/regressions/** binary
